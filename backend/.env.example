PORT=3002

# Redis 连接地址。显式用 127.0.0.1，避免 localhost 解析到 ::1 带来的不确定性。
# 两种部署方式二选一，不要同时占用同一个宿主端口：
#   1) 使用宿主机自带 Redis：REDIS_URL=redis://127.0.0.1:6379
#   2) 使用 docker-compose 的 redis 容器（compose 已映射宿主 6380）：REDIS_URL=redis://127.0.0.1:6380
REDIS_URL=redis://127.0.0.1:6379

# 可选：启动自检。设置后期望连接的 Redis 可执行文件必须匹配，否则打印错误并退出。
# 不设置则只打印实例指纹（executable / pid / port / version）。
# 宿主机 Homebrew Redis：/opt/homebrew/opt/redis/bin/redis-server
# docker 容器内 Redis：/data/redis-server
# REDIS_EXPECT_EXECUTABLE=/opt/homebrew/opt/redis/bin/redis-server
# REDIS_STRICT=0            # 设为 0 时，指纹不匹配只告警、不退出

MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_USER=root
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=auction_master
